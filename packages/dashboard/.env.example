# ForkFlux Dashboard — environment variables
#
# Copy this file to `.env` for local use (`.env` is gitignored).
# API is the default data source. Use `npm run dev:mocked` for mock fixtures.

# Base URL of the ForkFlux API, including the /api/v1 prefix.
# Required when FE_USE_MOCKS is not "true".
# Local dev default: http://localhost:8000/api/v1
FE_API_BASE_URL=http://localhost:8000/api/v1

# When "true", use the in-memory mock data source (mocks/*.json) instead of
# the live API. Unset by default → API mode. Set inline via dev:mocked.
# FE_USE_MOCKS=true
